# SIRA Community - Discourse Environment (ONE PRODUCT TEMPLATE)
#
# Copy to a local file and fill secrets locally. Do NOT commit the copied file.
#
# Example:
#   cp docker/env.discourse.oneproduct.example docker/env.discourse.oneproduct.local
#
# This is intended to run Discourse behind SIRA App at:
#   https://<env>.app.sira.ai/community
#

# ============================================
# One Product /community configuration
# ============================================
# IMPORTANT: DISCOURSE_HOSTNAME must NOT include port.
# - Local example:
#   DISCOURSE_HOSTNAME=local.app.sira.ai
#   DISCOURSE_PORT=8445
# - Stage example:
#   DISCOURSE_HOSTNAME=stage.app.sira.ai
#   DISCOURSE_PORT=443
DISCOURSE_HOSTNAME=local.app.sira.ai
DISCOURSE_PORT=8445
DISCOURSE_FORCE_HTTPS=1
DISCOURSE_RELATIVE_URL_ROOT=/community

# Admin bootstrap convenience (optional)
DISCOURSE_DEVELOPER_EMAILS=admin@sirahub.ai

# ============================================
# Secrets (REQUIRED)
# ============================================
# Generate with: ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"
DISCOURSE_SECRET_KEY_BASE=CHANGE_ME_128_CHAR_SECRET_KEY_BASE
SECRET_KEY_BASE=CHANGE_ME_128_CHAR_SECRET_KEY_BASE

# ============================================
# Database (SIRA infra)
# ============================================
COMMUNITY_DB_NAME=sira_community
COMMUNITY_DB_USERNAME=sira_community_user
COMMUNITY_DB_PASSWORD=CHANGE_ME_COMMUNITY_DB_PASSWORD
COMMUNITY_DB_POOL=8
DISCOURSE_DB_SSL_MODE=require

# ============================================
# Redis (SIRA infra)
# ============================================
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_TLS=false

# ============================================
# SMTP (optional but recommended for prod)
# ============================================
DISCOURSE_NOTIFICATION_EMAIL=CHANGE_ME_FROM_EMAIL
DISCOURSE_SMTP_ADDRESS=CHANGE_ME_SMTP_HOST
DISCOURSE_SMTP_PORT=587
DISCOURSE_SMTP_USER_NAME=CHANGE_ME_SMTP_USER
DISCOURSE_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
DISCOURSE_SMTP_DOMAIN=CHANGE_ME_SMTP_DOMAIN
DISCOURSE_SMTP_ENABLE_START_TLS=true

# ============================================
# SIRA AI Integration (optional)
# ============================================
SIRA_API_URL=http://api.sira.ai
SIRA_API_KEY=CHANGE_ME_SIRA_API_KEY


