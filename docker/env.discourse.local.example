# SIRA Community - Discourse Environment Configuration (LOCAL TEMPLATE)
#
# Copy this file to `docker/env.discourse.local` and fill in secrets locally.
# IMPORTANT: `docker/env.discourse.local` is intentionally git-ignored.
#
# This repo’s local dev hostname is:
# - https://local.community.sira.ai:8443
#

# ============================================
# Discourse Core Configuration
# ============================================
# NOTE: DISCOURSE_HOSTNAME must NOT include port.
DISCOURSE_HOSTNAME=local.community.sira.ai
DISCOURSE_PORT=8443
DISCOURSE_FORCE_HTTPS=1
DISCOURSE_DEVELOPER_EMAILS=admin@sirahub.ai

# Email "from" address (should match your SMTP sender)
DISCOURSE_NOTIFICATION_EMAIL=info@sirahub.ai

# ============================================
# Database Configuration (Dedicated SIRA Community PostgreSQL)
# ============================================
COMMUNITY_DB_NAME=sira_community
COMMUNITY_DB_USERNAME=sira_community_user
COMMUNITY_DB_PASSWORD=CHANGE_ME_COMMUNITY_DB_PASSWORD
COMMUNITY_DB_POOL=8
DISCOURSE_DB_SSL_MODE=require

# ============================================
# Redis Configuration (Dedicated SIRA Community Redis)
# ============================================
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_TLS=false

# ============================================
# SMTP/Email Configuration
# ============================================
DISCOURSE_SMTP_ADDRESS=smtp.hostinger.com
DISCOURSE_SMTP_PORT=587
DISCOURSE_SMTP_USER_NAME=info@sirahub.ai
DISCOURSE_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
DISCOURSE_SMTP_DOMAIN=sirahub.ai
DISCOURSE_SMTP_ENABLE_START_TLS=true

# ============================================
# Security
# ============================================
# Generate with: ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"
COMMUNITY_SECRET_KEY_BASE=CHANGE_ME_128_CHAR_SECRET_KEY_BASE

# ============================================
# SIRA AI Integration
# ============================================
SIRA_API_URL=http://api.sira.ai
SIRA_API_KEY=CHANGE_ME_SIRA_API_KEY

# ============================================
# Performance
# ============================================
NUM_WEBS=2
SKIP_DB_AND_REDIS=0
DISCOURSE_SERVE_STATIC_ASSETS=1


