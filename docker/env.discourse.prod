# SIRA Community - Discourse Production Environment Configuration
# Production-grade configuration for Discourse running behind Nginx with HTTPS
#
# IMPORTANT: Replace all placeholder values before deploying to production.

# ============================================
# Discourse Core Configuration
# ============================================
DISCOURSE_HOSTNAME=community.sira.ai
DISCOURSE_DEVELOPER_EMAILS=admin@sira.ai

# Enforce HTTPS at the application level (behind Nginx TLS termination)
DISCOURSE_FORCE_HTTPS=1

# ============================================
# Database Configuration (Infrastructure PostgreSQL with mTLS)
# ============================================
COMMUNITY_DB_NAME=community_prod
COMMUNITY_DB_USERNAME=community
COMMUNITY_DB_PASSWORD=CHANGE_ME_STRONG_PROD_DB_PASSWORD
COMMUNITY_DB_POOL=15

# PostgreSQL SSL Configuration (mTLS)
DISCOURSE_DB_HOST=postgres-community
DISCOURSE_DB_PORT=5432
DISCOURSE_DB_NAME=${COMMUNITY_DB_NAME}
DISCOURSE_DB_USERNAME=${COMMUNITY_DB_USERNAME}
DISCOURSE_DB_PASSWORD=${COMMUNITY_DB_PASSWORD}
DISCOURSE_DB_POOL=${COMMUNITY_DB_POOL}
DISCOURSE_DB_SSL_MODE=require
DISCOURSE_DB_SSL_CERT=/opt/sira-ai/ssl/server/postgres-community/client/app-client.crt
DISCOURSE_DB_SSL_KEY=/opt/sira-ai/ssl/server/postgres-community/client/app-client.key
DISCOURSE_DB_SSL_CA=/opt/sira-ai/ssl/ca/ca.crt

# ============================================
# Redis Configuration (Infrastructure Redis with TLS)
# ============================================
REDIS_PORT=6380
REDIS_PASSWORD=CHANGE_ME_STRONG_PROD_REDIS_PASSWORD
REDIS_TLS=true

DISCOURSE_REDIS_HOST=redis-community
DISCOURSE_REDIS_PORT=${REDIS_PORT}
DISCOURSE_REDIS_PASSWORD=${REDIS_PASSWORD}
DISCOURSE_REDIS_USE_SSL=${REDIS_TLS}
DISCOURSE_REDIS_SSL_CERT=/opt/sira-ai/ssl/server/redis/redis-client.crt
DISCOURSE_REDIS_SSL_KEY=/opt/sira-ai/ssl/server/redis/redis-client.key
DISCOURSE_REDIS_SSL_CA=/opt/sira-ai/ssl/ca/ca.crt

# ============================================
# SMTP/Email Configuration
# ============================================
DISCOURSE_SMTP_ADDRESS=smtp.sendgrid.net
DISCOURSE_SMTP_PORT=587
DISCOURSE_SMTP_USER_NAME=apikey
DISCOURSE_SMTP_PASSWORD=CHANGE_ME_SENDGRID_API_KEY
DISCOURSE_SMTP_DOMAIN=sira.ai
DISCOURSE_SMTP_ENABLE_START_TLS=true

# ============================================
# Security
# ============================================
# Generate with: ruby -e "require 'securerandom'; puts SecureRandom.hex(64)"
COMMUNITY_SECRET_KEY_BASE=CHANGE_ME_128_CHAR_SECRET_KEY_BASE

# ============================================
# SIRA AI Integration
# ============================================
SIRA_API_URL=https://api.sira.ai
SIRA_API_KEY=CHANGE_ME_PRODUCTION_SIRA_API_KEY

# ============================================
# Performance
# ============================================
NUM_WEBS=4
SKIP_DB_AND_REDIS=0


